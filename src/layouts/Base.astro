---
import BaseHead from "@/components/BaseHead.astro";
import LangRedirect from "@/components/LangRedirect.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { defaultLang, locales } from "@/i18n/ui";
import { getLangFromUrl, getNeutralPath, useTranslations } from "@/i18n/utils";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	/**
	 * Chemin (sans base ni préfixe de langue) de cette page dans l'autre langue.
	 * Par défaut : la page miroir. Passer un autre chemin (ex. "/projects/") quand la
	 * traduction n'existe pas : le sélecteur y renvoie et aucun hreflang n'est émis.
	 */
	alternatePath?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = getNeutralPath(Astro.url);

const {
	meta: { articleDate, description = t("site.description"), ogImage, title },
	alternatePath = currentPath,
} = Astro.props;
const hreflangPath = alternatePath === currentPath ? currentPath : undefined;
---

<html class="scroll-smooth" lang={locales[lang].htmlLang}>
	<head>
		{lang === defaultLang && currentPath === "/" && <LangRedirect />}
		<ThemeProvider />
		<BaseHead
			articleDate={articleDate}
			description={description}
			hreflangPath={hreflangPath}
			lang={lang}
			ogImage={ogImage}
			title={title}
		/>
	</head>
	<body>
		<SkipLink />
		<div class="wrap">
			<Header alternatePath={alternatePath} lang={lang} />
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>

		<style is:global>
			html {
				scrollbar-gutter: stable;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				overflow-x: clip;
			}
			body {
				background-color: hsl(var(--theme-bg));
				color: hsl(var(--theme-text));
				font-family: var(--font-serif);
				font-size: 18px;
				line-height: 1.62;
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				text-rendering: optimizeLegibility;
				min-height: 100vh;
				min-height: 100dvh;
			}
			html.theme-ready body {
				transition: background-color 0.35s ease, color 0.35s ease;
			}
			a {
				color: inherit;
				text-decoration: none;
				transition: color 0.2s ease, border-color 0.2s ease;
			}

			/* Sticky footer: wrap fills viewport, main grows to push footer down */
			.wrap {
				max-width: 760px;
				margin: 0 auto;
				padding: 36px max(32px, env(safe-area-inset-right))
					max(80px, env(safe-area-inset-bottom)) max(32px, env(safe-area-inset-left));
				min-height: 100vh;
				min-height: 100dvh;
				display: flex;
				flex-direction: column;
			}
			.wrap > main { flex: 1 0 auto; }

			@media (max-width: 720px) {
				.wrap {
					padding: 18px max(22px, env(safe-area-inset-right))
						max(56px, env(safe-area-inset-bottom)) max(22px, env(safe-area-inset-left));
				}
				body {
					font-size: 17px;
				}
			}

			@media (max-width: 420px) {
				.wrap {
					padding: 14px max(16px, env(safe-area-inset-right))
						max(44px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
				}
				body {
					font-size: 16.5px;
				}
			}
		</style>
	</body>
</html>
