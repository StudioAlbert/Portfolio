---
import { getAllPosts } from "@/data/post";
import { getEntrySlug } from "@/i18n/utils";
import PostLayout from "@/layouts/BlogPost.astro";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";

// getStaticPaths ne tourne pas avec un adaptateur SSR : https://docs.astro.build/en/guides/routing/
export const getStaticPaths = (async () => {
	const blogEntries = await getAllPosts("en");
	const translated = new Set((await getAllPosts("fr")).map((p) => getEntrySlug(p.id)));
	return blogEntries.map((entry) => {
		const slug = getEntrySlug(entry.id);
		return { params: { slug }, props: { entry, hasTranslation: translated.has(slug) } };
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, hasTranslation } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout hasTranslation={hasTranslation} lang="en" post={entry}>
	<Content />
</PostLayout>
