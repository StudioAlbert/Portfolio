---
import PostsPage from "@/components/pages/PostsPage.astro";
import { getAllPosts, sortMDByDate } from "@/data/post";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 1000;
	const allPostsByDate = sortMDByDate(await getAllPosts("en"));
	return paginate(allPostsByDate, { pageSize: MAX_POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;
---

<PostsPage page={page} lang="en" />
