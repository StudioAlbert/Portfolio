---
import ProjectPage from "@/components/pages/ProjectPage.astro";
import { getProjects } from "@/data/project";
import { getEntrySlug } from "@/i18n/utils";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

export const getStaticPaths = (async () => {
	const projects = await getProjects("en");
	const translated = new Set((await getProjects("fr")).map((p) => getEntrySlug(p.id)));
	return projects.map((entry) => {
		const slug = getEntrySlug(entry.id);
		return { params: { slug }, props: { entry, hasTranslation: translated.has(slug) } };
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, hasTranslation } = Astro.props;
---

<ProjectPage entry={entry} hasTranslation={hasTranslation} lang="en" />
