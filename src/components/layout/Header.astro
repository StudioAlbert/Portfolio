---
import { flagIcons } from "@/data/icons";
import { type Lang, languages, locales } from "@/i18n/ui";
import { localizePath, useTranslations } from "@/i18n/utils";
import { menuLinks, siteConfig } from "@/site-config";
import ThemeToggle from "../ThemeToggle.astro";

interface Props {
	lang: Lang;
	/** Chemin (sans base ni langue) visé par le sélecteur de langue. */
	alternatePath: string;
}

const { alternatePath, lang } = Astro.props;
const t = useTranslations(lang);
const url = new URL(Astro.request.url);
const wordmark = siteConfig.title;

const visibleMenuLinks = menuLinks;
const allLangs = Object.keys(languages) as Lang[];

const isActive = (path: string) => {
	const target = localizePath(path, lang);
	if (path === "/") return url.pathname === target;
	return url.pathname === target || url.pathname.startsWith(target);
};

const navIcons: Record<string, string> = {
	"/": '<path d="M2.5 6.5 8 2l5.5 4.5V13a1 1 0 0 1-1 1h-2.5v-4h-4v4H3.5a1 1 0 0 1-1-1Z"/>',
	"/posts/":
		'<path d="M3 2.5h7l3 3V13a.5.5 0 0 1-.5.5h-9.5a.5.5 0 0 1-.5-.5V3a.5.5 0 0 1 .5-.5Z"/><path d="M10 2.5V5.5h3"/><path d="M5.5 8.5h5"/><path d="M5.5 11h3.5"/>',
	"/projects/":
		'<rect x="2" y="4.5" width="12" height="8.5" rx="1"/><path d="M5.5 4.5V3a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v1.5"/>',
	"/resume/":
		'<circle cx="8" cy="6" r="2.5"/><path d="M3 13c.6-2.4 2.6-3.5 5-3.5s4.4 1.1 5 3.5"/>',
};
---

<header class="site-header" id="main-header">
	<a href={localizePath("/", lang)} class="wordmark">{wordmark}</a>
	<div class="header-right">
		<nav class="nav" aria-label="Primary">
			{
				visibleMenuLinks.map((link) => (
					<a
						aria-current={isActive(link.path) ? "page" : false}
						class:list={[{ active: isActive(link.path) }]}
						data-astro-prefetch
						href={localizePath(link.path, lang)}
					>
						<svg
							aria-hidden="true"
							viewBox="0 0 16 16"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							set:html={navIcons[link.path] ?? ""}
						/>
						<span>{t(link.key)}</span>
					</a>
				))
			}
		</nav>
		<div class="header-tools">
			<nav class="lang-switch" aria-label={t("lang.label")}>
				{
					allLangs.map((l, i) => (
						<Fragment>
							{i > 0 && <span class="sep" aria-hidden="true">·</span>}
							{l === lang ? (
								<span class="current" aria-current="true" lang={locales[l].htmlLang}>
									<span class="flag" set:html={flagIcons[l]} />
									{l.toUpperCase()}
								</span>
							) : (
								<a
									aria-label={languages[l]}
									data-astro-prefetch
									data-lang-choice={l}
									href={localizePath(alternatePath, l)}
									hreflang={locales[l].hreflang}
									lang={locales[l].htmlLang}
								>
									<span class="flag" set:html={flagIcons[l]} />
									{l.toUpperCase()}
								</a>
							)}
						</Fragment>
					))
				}
			</nav>
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 72px;
	}
	.wordmark {
		font-family: var(--font-serif);
		font-size: 17px;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: hsl(var(--theme-text));
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.wordmark:hover {
		color: hsl(var(--theme-accent));
	}
	.header-right {
		display: flex;
		align-items: baseline;
		gap: 22px;
	}
	/* Sélecteur de langue + bascule de thème : groupés pour tenir dans une seule
	   cellule de la grille mobile. */
	.header-tools {
		display: flex;
		align-items: baseline;
		gap: 16px;
	}
	.nav {
		display: flex;
		align-items: baseline;
		gap: 22px;
		font-family: var(--font-sans);
		font-size: 15px;
		color: hsl(var(--theme-text) / 0.9);
	}
	.nav a {
		display: inline-block;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.2s ease;
	}
	/* Indicator overhangs the text slightly so the underline isn't abrupt. */
	.nav a::after {
		content: "";
		position: absolute;
		left: -3px;
		right: -3px;
		bottom: 0;
		height: 1px;
		background: transparent;
	}
	.nav a svg {
		display: inline-block;
		width: 15px;
		height: 15px;
		stroke: currentColor;
		vertical-align: -2px;
		margin-right: 6px;
	}
	.nav a:hover {
		color: hsl(var(--theme-accent));
	}
	.nav a.active {
		color: hsl(var(--theme-text));
	}
	.nav a.active::after {
		background: hsl(var(--theme-accent));
	}

	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1.4;
	}
	.lang-switch a,
	.lang-switch .current {
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}
	.lang-switch .current {
		color: hsl(var(--theme-accent));
	}
	/* Drapeaux en SVG inline : les emoji drapeaux ne s'affichent pas sous Windows. */
	.lang-switch .flag {
		display: inline-flex;
		flex: 0 0 auto;
	}
	.lang-switch .flag :global(svg) {
		width: 16px;
		height: 12px;
		border-radius: 1px;
		box-shadow: 0 0 0 1px hsl(var(--theme-text) / 0.18);
	}
	.lang-switch .sep {
		color: var(--faint);
	}
	.lang-switch a {
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	.lang-switch a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.lang-switch a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 2px;
	}

	@media (max-width: 720px) {
		.site-header {
			margin-bottom: 36px;
			display: grid;
			grid-template-columns: 1fr auto;
			grid-template-areas:
				"wordmark theme"
				"nav nav";
			align-items: center;
			column-gap: 14px;
			row-gap: 14px;
		}
		.wordmark { grid-area: wordmark; }
		.header-right { display: contents; }
		.header-tools {
			grid-area: theme;
			justify-self: end;
			gap: 14px;
		}
		.nav {
			grid-area: nav;
			gap: 22px;
			font-size: 14px;
			flex-wrap: wrap;
			justify-content: flex-start;
		}
		.nav a {
			/* Add top tap padding; desktop rule keeps the indicator space below. */
			padding-top: 6px;
		}
		.nav a svg {
			width: 13px;
			height: 13px;
		}
	}

	@media (max-width: 420px) {
		.site-header {
			margin-bottom: 28px;
			row-gap: 12px;
		}
		.wordmark {
			font-size: 16px;
		}
		.nav {
			gap: 18px;
			font-size: 13px;
		}
		.nav a svg {
			display: none;
		}
		.header-tools {
			gap: 10px;
		}
		.lang-switch {
			font-size: 11.5px;
			gap: 5px;
		}
		.lang-switch .flag :global(svg) {
			width: 14px;
			height: 10.5px;
		}
	}
</style>

<script>
	// Mémorise le choix explicite de langue : la redirection sur l'accueil le respecte.
	for (const el of document.querySelectorAll<HTMLElement>("[data-lang-choice]")) {
		el.addEventListener("click", () => {
			try {
				localStorage.setItem("lang", el.dataset.langChoice ?? "");
			} catch {}
		});
	}
</script>
