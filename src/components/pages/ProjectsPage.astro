---
import { getProjects } from "@/data/project";
import type { Lang } from "@/i18n/ui";
import { getEntrySlug, localizePath, useTranslations } from "@/i18n/utils";
import PageLayout from "@/layouts/Base.astro";
import { Schema } from "astro-seo-schema";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const siteUrl = (path: string) => new URL(localizePath(path, lang), Astro.site).toString();

const projects = await getProjects(lang);
---

<Schema
	item={{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: t("nav.home"), item: siteUrl("/") },
			{ "@type": "ListItem", position: 2, name: t("projects.title"), item: siteUrl("/projects") },
		],
	}}
/>

<PageLayout meta={{ title: t("projects.title"), ogImage: t("og.projects") }}>
	<section class="work" aria-labelledby="work-label">
		<div class="section-label" id="work-label">{t("projects.title")}</div>
		<p class="intro">
			{t("projects.intro")}
		</p>
		<ul class="work-list">
			{projects.map((p) => (
				<li>
					<a href={localizePath(`/projects/${getEntrySlug(p.id)}/`, lang)}>
						<div class="head">
							<span class="name">{p.data.title}</span>
							{p.data.stack.length > 0 && (
								<span class="stack">{p.data.stack.join(" · ")}</span>
							)}
							{p.data.featured && <span class="badge">Featured</span>}
						</div>
						<p>{p.data.description}</p>
					</a>
				</li>
			))}
		</ul>
	</section>
</PageLayout>

<style>
	.work { margin-bottom: 88px; }
	.intro {
		font-family: var(--font-serif);
		font-size: 17.5px;
		line-height: 1.7;
		color: hsl(var(--theme-text));
		margin: 0 0 36px;
		max-width: 60ch;
		text-wrap: pretty;
	}
	@media (max-width: 720px) { .intro { font-size: 17px; margin-bottom: 28px; } }
	@media (max-width: 420px) {
		.work { margin-bottom: 56px; }
		.intro { font-size: 16.5px; }
	}
</style>
